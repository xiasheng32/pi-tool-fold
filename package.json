{
  "name": "pi-tool-fold",
  "version": "0.1.0",
  "description": "Pi 扩展：Claude Code 风格的工具折叠，标题与一行摘要，展开保留原有详情。\nPi extension: Claude Code-style tool folding with compact summaries and original expanded details.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiasheng32/pi-tool-fold.git"
  },
  "homepage": "https://github.com/xiasheng32/pi-tool-fold#readme",
  "bugs": {
    "url": "https://github.com/xiasheng32/pi-tool-fold/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tools",
    "tui",
    "collapse"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
